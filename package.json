{
  "name": "rewrap-plus-monorepo",
  "private": true,
  "license": "MIT",
  "description": "Monorepo for Rewrap+: a wrapping engine and its VSCode extension glue.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "node scripts/verify-grammar-provenance.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace=@rewrap-plus/engine",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "new-adapter": "node scripts/new-adapter.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@eslint/js": "^9.13.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
