{
  "name": "rewrap-plus",
  "displayName": "Rewrap+",
  "version": "0.0.1",
  "private": true,
  "description": "Rewraps comments, docstrings, and string literals to a configured column limit, preserving formatted structure and emitting language-valid concatenation.",
  "publisher": "jarinfrench",
  "license": "MIT",
  "categories": ["Formatters"],
  "engines": {
    "vscode": "^1.122.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rewrap-plus/engine": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.120.0",
    "vitest": "^4.1.11"
  }
}
