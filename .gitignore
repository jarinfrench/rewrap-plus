# Node
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# Build output
dist/
out/
out-test/
*.tsbuildinfo

# Grammar WASM copied into the extension package by
# packages/vscode-extension/scripts/build.mjs -- the checked-in original
# lives in packages/engine/grammars/ (see that dir's PROVENANCE.md).
packages/vscode-extension/grammars/

# Root LICENSE and THIRD-PARTY-NOTICES.md copied into the extension
# package by the same build script, so `vsce package` finds a LICENSE
# and the packaged .vsix carries its own notices, without a second
# checked-in copy of either.
packages/vscode-extension/LICENSE
packages/vscode-extension/THIRD-PARTY-NOTICES.md

# @vscode/test-electron's downloaded VSCode instance + extension sandbox
.vscode-test/

# VSCode extension packaging
*.vsix

# Test / coverage
coverage/
.vitest-cache/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Local planning/handoff docs -- private roadmap and design notes, not
# published. See docs/planning/ for what lives here.
docs/planning/

# Generated at deploy time by scripts/generate-site-data.mjs (the `pages`
# job in .github/workflows/ci.yml) from packages/engine's own adapter
# registry -- never hand-edited, and never committed, so it can't become
# a second stale source of truth for language coverage.
site/data/languages.json
